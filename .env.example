# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telethon StringSession for the Telegram account that can access the public group
TELEGRAM_SESSION=

# Public group username (for example: @examplegroup) or numeric chat ID
TELEGRAM_SOURCE_CHATS=

# Discord channel webhook URL
DISCORD_WEBHOOK_URL=

# At least one filter is required. Comma-separated values.
FILTER_KEYWORDS=
FILTER_USERS=
FILTER_REGEX=
# any = match at least one configured filter; all = match every configured filter category
FILTER_MODE=any
# Optional comma-separated exclusions
EXCLUDE_KEYWORDS=

# Optional settings
FORWARD_EDITED_MESSAGES=false
DATABASE_PATH=/app/data/bridge_state.sqlite3
LOG_LEVEL=INFO
